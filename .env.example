# Copy this file to .env and put your real keys THERE. Never put real keys in this file.
# Each key gets 7 seconds; if it's slow or fails, the next key is tried automatically.
AI_ORDER=gemini,groq,xai
AI_TIMEOUT=7

# Google Gemini (free: aistudio.google.com)
GEMINI_API_KEY_1=your-key-here
GEMINI_API_KEY_2=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Groq (free, very fast: console.groq.com) – keys start with gsk_
GROQ_API_KEY_1=your-key-here
GROQ_API_KEY_2=your-key-here
GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b

# xAI Grok (paid: console.x.ai) – optional
XAI_API_KEY_1=your-key-here
XAI_MODEL=grok-4-fast

# USDA FoodData Central (fdc.nal.usda.gov) – optional
FDC_API_KEY=your-key-here
